// FIXTURE (keyline-corporate): generated by gen.py from templates/families/keyline-corporate/resume.typ
// FAMILY: keyline-corporate — contemporary corporate report: accent keylines, ruled rows
// ---------- Shared mechanics (templates/lib.typ) ----------
// Devices below stay this family's own; only the verified MECHANICS come from
// the lib (entry emission order, extraction-safe skills row, unbreakable
// mark+value box, platform marks, generic icon sets).
#import "../../templates/lib.typ": *
// vertical rhythm: 1.000 as designed; a tuner stretches every pt gap through it
#let rhythm = 1.000
#let accent = rgb("#33475b")
// Coordinated palette (monochrome harmony): one accent + derived roles.
// soft = same hue lightened, for decorative hairlines only (never text).
// ink  = metadata gray biased 15% toward the accent hue (a pure neutral gray
//        next to a warm accent reads as a mismatch). dark = body ink, 8% biased.
#let pal = derive(accent)
#let soft = pal.soft
#let ink = pal.ink
#let muted = ink
#let dark = pal.dark
#let bodyf = ("Noto Sans", "Liberation Sans")
#let dispf = ("Vazirmatn", "Noto Sans", "Liberation Sans")

// Line icon style: thin stroke, rounded — belongs to this family's light register.
#let ic-col = accent
#let ic = icons-line(ic-col)
#let mk = marks(ic-col)
#let ic = gate-icons(ic, mk)   // drawn icons follow marks' all-or-nothing

#set page(paper: "us-letter", margin: (x: 1.5cm, top: 1.2cm, bottom: 1.2cm))
#set page(..wd-page) if workday
// opt-in accent band (pick_design.py --band flips this): a text-free strip in the
// left margin, drawn in the page background (lib.typ accent-band)
#let band = false
#set page(background: accent-band(accent)) if band
// PDF/UA-1 needs a document title: the person's name. Fill it once here; the header below reuses it.
#let doc-name = "Firstname Lastname"
#set document(title: doc-name, author: doc-name)
#set text(font: bodyf, size: 10.5pt, lang: "en", fill: dark, hyphenate: false)
#set par(justify: false, leading: 0.544em, spacing: 0.624em)

// device: a `soft` rule ACROSS the boundary, plus the accent keyline down the
// left of the title. The rule is what separates sections — the vertical
// keyline marks the title and is invisible to a horizontal boundary scan,
// which is why this family used to buy separation with empty space alone.
#let section(t, body, airy: false) = block(breakable: false,
  above: if airy { 20.5pt * rhythm } else { 16.5pt * rhythm }, below: 0pt)[
  #block(above: 0pt, below: 5pt * rhythm)[#line(length: 100%, stroke: 0.6pt + soft)]
  #box(inset: (left: 11pt), stroke: (left: 4pt + accent))[
    #text(font: dispf, size: 13pt, weight: "bold", fill: dark)[#t]
  ]
  #v(11.5pt * rhythm)
  #block(above: 0pt, below: 0pt, width: 100%, body)
]

#let job(role, org, dates, note) = entry(role, org, dates, note,
  date-st: it => text(size: 9pt, fill: accent, weight: "bold", it),
  note-st: it => text(fill: muted, it), rhythm: rhythm)

// skills: the label itself carries the accent — no separator, no rule
#let skill(cat, items) = srow(text(fill: accent, weight: "bold")[#cat], items)

#set list(marker: list-marker("dash", dark), indent: 10pt, spacing: 0.698em, body-indent: 6pt)

// header: name row, then role left + 2-line contact block right (column = natural width, max 55%); contact never shares a y-range with the name, no rule. No photo is wired: a photo would take the right end of the name row
#block(above: 0pt, below: 12pt * rhythm)[
  #header-two-row(
    [#text(font: dispf, size: 24pt, weight: "bold")[#doc-name]],
    [#text(size: 10.5pt, weight: "medium")[[Target title, as in the facts or posting] — [Degree, if the facts state it]]],
    text(size: 9pt, fill: muted)[#set par(leading: 0.42em); #contact-rows(2)#contact(ic.pin)[\[City, Region\]] #h(10pt) #contact(ic.tel)[#link("tel:+15555550100")[(555) 555-0100]] #h(10pt) #contact(mk.mail)[#link("mailto:me@example.com")[me\@example.com]] \
      #contact(mk.web)[\[profile or portfolio — only if in the facts\]]],
    row-gutter: 6pt * rhythm,
  )
]

// ---------- Profile ----------
// Workday mode (--input workday=1): drops Profile/Summary, tracks the section name.
#let section = wd-section(section)
// Profile: only what the facts state (role, field, level, outcome); length follows
// the facts; no trait sentence.


